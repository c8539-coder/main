# ---- Discord ----
# Токен бота из https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your-discord-bot-token

# ---- OpenSea ----
# Бесплатный API-ключ: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your-opensea-api-key

# ---- Настройки бота (необязательно) ----
# Как часто опрашивать OpenSea на новые события, в секундах (минимум 15)
POLL_INTERVAL_SECONDS=60

# Файл, где хранятся подписки и курсоры (создаётся автоматически)
DATA_FILE=data/subscriptions.json

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
