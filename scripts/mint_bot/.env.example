# ---- Discord ----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
DISCORD_ROLE_ID=

# ---- Thresholds & polling ----
MINT_ALERT_MIN=5
MINT_PING_MIN=15
MINT_PING_STEP=15
# also alert on buys/sweeps (not only mints): 1 = on, 0 = mints only
TRACK_BUYS=1
# a buy counts only if it's a confirmed marketplace sale (Seaport/OpenSea): 1 = on
# (only used for the on-chain fallback when OPENSEA_API_KEY is not set)
SALES_ONLY=1
# OpenSea API key -> each buy is confirmed OpenSea-only via the OpenSea REST API
# (exact ETH/WETH price too). Leave empty to use the on-chain Seaport fallback.
# Get one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
MINT_POLL_SECONDS=60
MINT_WINDOW_SECONDS=21600
MINT_BACKFILL_BLOCKS=300
MINT_CHAINS=robinhood-mainnet,eth-mainnet

# ---- Watchlist ----
WATCHLIST_FILES=scripts/nft_top_wallets/out/good_wallets.csv
WATCHLIST_MIN_SCORE=0

# ---- Misc ----
STATE_FILE=data/mint_bot_state.json
LOG_LEVEL=INFO

# ---- Alchemy ----
ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-key
ALCHEMY_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
