# ---- Discord ----
# URL вебхука канала: Настройки канала -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy
# ID роли для пинга (необязательно). Включи Developer Mode, ПКМ по роли -> Copy ID
DISCORD_ROLE_ID=

# ---- Порог и опрос ----
# Сколько кошельков должны заминтить одну коллекцию для ТИХОГО алерта (без пинга)
MINT_ALERT_MIN=5
# С какого числа кошельков пинговать роль (крупный сигнал)
MINT_PING_MIN=15
# Повторный пинг каждые +N кошельков после первого (пинги на 15, 30, 45…). 0 = только один раз
MINT_PING_STEP=15
# Как часто опрашивать сети, сек (минимум 15)
MINT_POLL_SECONDS=60
# Окно накопления минтов по контракту, сек (по умолчанию 6 часов)
MINT_WINDOW_SECONDS=21600
# Сколько блоков назад смотреть при первом старте
MINT_BACKFILL_BLOCKS=300
# Какие сети отслеживать (через запятую)
MINT_CHAINS=robinhood-mainnet,eth-mainnet

# ---- Watchlist ----
# CSV со списком кошельков (address[,type]); можно несколько через запятую и glob
WATCHLIST_FILES=scripts/nft_top_wallets/out/good_wallets.csv
# Фильтр по total_score, если колонка есть (0 = без фильтра)
WATCHLIST_MIN_SCORE=0

# ---- Прочее ----
STATE_FILE=data/mint_bot_state.json
LOG_LEVEL=INFO

# ---- Alchemy (те же ключи, что и у сборщика кошельков) ----
# Сеть коллекций (robinhood-mainnet) + Ethereum mainnet для eth-коллекций
ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-key
ALCHEMY_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
