# ---- Alchemy: сеть коллекции (Robinhood mainnet) ----
# Вариант A (проще): полный endpoint вместе с ключом
ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your-key
# Вариант B: ключ + имя сети (endpoint соберётся сам)
# ALCHEMY_API_KEY=your-key
# ALCHEMY_NETWORK=robinhood-mainnet

# ---- Alchemy: mainnet для blue-chip обогащения (необязательно) ----
# Если не задать — smart-money считается только по основной сети.
ALCHEMY_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# ALCHEMY_MAINNET_API_KEY=your-key
# ALCHEMY_MAINNET_NETWORK=eth-mainnet

# ---- Контракт коллекции по умолчанию ----
COLLECTION_CONTRACT=0x116eaa62241751e0c98da43d458600c6c17cd361

# ---- Тюнинг (необязательно) ----
# REQUEST_DELAY_S=0.12
# MAX_RETRIES=5
